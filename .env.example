# Copy to .env.local and fill in. Never commit real values.

# Required for live guide generation (server-side only).
GEMINI_API_KEY=

# Optional: override the Gemini model id.
# GEMINI_MODEL=

# Optional: durable storage for live-generated guides (Upstash Redis REST, or Vercel KV equivalents).
# Without these, live guides are kept in server memory and disappear on restart/redeploy.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
