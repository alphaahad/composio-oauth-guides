# Copy to .env.local and fill in. Never commit real values.

# Required for live guide generation (server-side only).
GEMINI_API_KEY=

# Optional: comma-separated Gemini model ids to try in order (falls back when one is overloaded or out of quota).
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional: durable storage for live-generated guides (Upstash Redis REST, or Vercel KV equivalents).
# Without these, live guides are saved under .data/live (fine locally, but not shared between serverless instances).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local development only: skip the per-IP and global request limits (ignored when NODE_ENV=production).
# DISABLE_RATE_LIMIT=1
